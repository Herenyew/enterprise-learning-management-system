// Enterprise Learning Management System
// Prisma ORM schema for PostgreSQL.
//
// This file is now the implementation source of truth for the database model.
// The earlier SQL migration remains useful as a reference, but future migrations
// should be generated from this Prisma schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Stable workflow enums.
// Business-configurable values such as course levels, categories, content
// types, and question types are represented as tables.
// ---------------------------------------------------------------------------

enum ActorStatus {
  ACTIVE    @map("active")
  INVITED   @map("invited")
  SUSPENDED @map("suspended")
  ARCHIVED  @map("archived")

  @@map("actor_status")
}

enum RecordStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
  ARCHIVED @map("archived")
  RETIRED  @map("retired")

  @@map("record_status")
}

enum PublishStatus {
  DRAFT     @map("draft")
  IN_REVIEW @map("in_review")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")
  RETIRED   @map("retired")

  @@map("publish_status")
}

enum VisibilityScope {
  PUBLIC     @map("public")
  PRIVATE    @map("private")
  RESTRICTED @map("restricted")

  @@map("visibility_scope")
}

enum SourceKind {
  DEVICE_UPLOAD @map("device_upload")
  GOOGLE_DRIVE  @map("google_drive")
  EXTERNAL_URL  @map("external_url")
  BUILT_IN      @map("built_in")

  @@map("source_kind")
}

enum EnrollmentStatus {
  ASSIGNED    @map("assigned")
  ENROLLED    @map("enrolled")
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")
  FAILED      @map("failed")
  CANCELLED   @map("cancelled")
  EXPIRED     @map("expired")

  @@map("enrollment_status")
}

enum AssessmentPolicy {
  DISABLED  @map("disabled")
  OPTIONAL  @map("optional")
  MANDATORY @map("mandatory")

  @@map("assessment_policy")
}

enum QuizKind {
  PRE_COURSE    @map("pre_course")
  CHAPTER       @map("chapter")
  END_OF_COURSE @map("end_of_course")
  POST_COURSE   @map("post_course")
  STANDALONE    @map("standalone")

  @@map("quiz_kind")
}

enum AttemptStatus {
  STARTED   @map("started")
  SUBMITTED @map("submitted")
  PASSED    @map("passed")
  FAILED    @map("failed")
  ABANDONED @map("abandoned")

  @@map("attempt_status")
}

enum AssignmentSubmissionType {
  FILE @map("file")
  TEXT @map("text")
  LINK @map("link")

  @@map("assignment_submission_type")
}

enum AssignmentSubmissionStatus {
  NOT_SUBMITTED @map("not_submitted")
  SUBMITTED     @map("submitted")
  LATE          @map("late")
  RETURNED      @map("returned")
  GRADED        @map("graded")

  @@map("assignment_submission_status")
}

enum SurveyStatus {
  DRAFT    @map("draft")
  ACTIVE   @map("active")
  CLOSED   @map("closed")
  ARCHIVED @map("archived")

  @@map("survey_status")
}

enum CertificateStatus {
  DRAFT   @map("draft")
  ISSUED  @map("issued")
  REVOKED @map("revoked")
  EXPIRED @map("expired")
  RENEWED @map("renewed")

  @@map("certificate_status")
}

enum ApprovalStatus {
  PENDING   @map("pending")
  APPROVED  @map("approved")
  REJECTED  @map("rejected")
  CANCELLED @map("cancelled")

  @@map("approval_status")
}

enum ApprovalActionType {
  SUBMITTED @map("submitted")
  APPROVED  @map("approved")
  REJECTED  @map("rejected")
  RETURNED  @map("returned")
  CANCELLED @map("cancelled")

  @@map("approval_action_type")
}

enum TnaStatus {
  DRAFT     @map("draft")
  SUBMITTED @map("submitted")
  APPROVED  @map("approved")
  REJECTED  @map("rejected")
  FULFILLED @map("fulfilled")
  CANCELLED @map("cancelled")

  @@map("tna_status")
}

enum ModerationStatus {
  OPEN      @map("open")
  REVIEWING @map("reviewing")
  RESOLVED  @map("resolved")
  DISMISSED @map("dismissed")

  @@map("moderation_status")
}

enum XpEventType {
  COURSE_COMPLETION  @map("course_completion")
  QUIZ_COMPLETION    @map("quiz_completion")
  QUIZ_PASS          @map("quiz_pass")
  PERFECT_SCORE      @map("perfect_score")
  PROGRAM_COMPLETION @map("program_completion")
  MANUAL_ADJUSTMENT  @map("manual_adjustment")

  @@map("xp_event_type")
}

enum LeaderboardBasis {
  XP_POINTS           @map("xp_points")
  COURSE_COMPLETION   @map("course_completion")
  PROGRAM_PERFORMANCE @map("program_performance")

  @@map("leaderboard_basis")
}

enum ResetFrequency {
  WEEKLY    @map("weekly")
  MONTHLY   @map("monthly")
  QUARTERLY @map("quarterly")
  NEVER     @map("never")

  @@map("reset_frequency")
}

enum ReportRunStatus {
  QUEUED    @map("queued")
  RUNNING   @map("running")
  COMPLETED @map("completed")
  FAILED    @map("failed")

  @@map("report_run_status")
}

enum AttemptEndReason {
  SUBMITTED     @map("submitted")
  TIME_EXPIRED  @map("time_expired")
  ABANDONED     @map("abandoned")
  CANCELLED     @map("cancelled")
  SYSTEM_CLOSED @map("system_closed")

  @@map("attempt_end_reason")
}

enum CertificateAssignmentScope {
  ORGANIZATION @map("organization")
  PROGRAM_TYPE @map("program_type")
  PROGRAM      @map("program")
  COURSE       @map("course")

  @@map("certificate_assignment_scope")
}

enum CertificateLayerType {
  TEXT      @map("text")
  IMAGE     @map("image")
  SIGNATURE @map("signature")
  SEAL      @map("seal")
  QR_CODE   @map("qr_code")
  BORDER    @map("border")
  SHAPE     @map("shape")

  @@map("certificate_layer_type")
}

enum NotificationChannel {
  IN_APP  @map("in_app")
  EMAIL   @map("email")
  SMS     @map("sms")
  PUSH    @map("push")
  WEBHOOK @map("webhook")

  @@map("notification_channel")
}

enum NotificationDeliveryStatus {
  QUEUED    @map("queued")
  SENT      @map("sent")
  DELIVERED @map("delivered")
  FAILED    @map("failed")
  CANCELLED @map("cancelled")

  @@map("notification_delivery_status")
}

enum ReportExportFormat {
  PDF  @map("pdf")
  XLSX @map("xlsx")
  CSV  @map("csv")
  JSON @map("json")

  @@map("report_export_format")
}

enum ReportScheduleFrequency {
  DAILY     @map("daily")
  WEEKLY    @map("weekly")
  MONTHLY   @map("monthly")
  QUARTERLY @map("quarterly")
  CRON      @map("cron")

  @@map("report_schedule_frequency")
}

enum TnaFulfillmentStatus {
  NOT_STARTED @map("not_started")
  SOURCED     @map("sourced")
  ASSIGNED    @map("assigned")
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")
  CANCELLED   @map("cancelled")

  @@map("tna_fulfillment_status")
}

model Organization {
  id            String       @id @default(uuid()) @db.Uuid
  name          String       @unique
  legalName     String?      @map("legal_name")
  primaryDomain String?      @map("primary_domain") @db.Citext
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  departments                      Department[]
  workUnits                        WorkUnit[]
  jobTitles                        JobTitle[]
  competencyGapAreas               CompetencyGapArea[]
  users                            User[]
  fileAssets                       FileAsset[]
  courseCategories                 CourseCategory[]
  courseLevels                     CourseLevel[]
  contentTypes                     ContentType[]
  questionTypes                    QuestionType[]
  externalProviders                ExternalProvider[]
  approvalWorkflows                ApprovalWorkflow[]
  certificateTemplates             CertificateTemplate[]
  programTypes                     ProgramType[]
  programs                         Program[]
  programTemplates                 ProgramTemplate[]
  programTemplateTargetDepartments ProgramTemplateTargetDepartment[]
  programTemplateTargetWorkUnits   ProgramTemplateTargetWorkUnit[]
  programTemplateTargetJobTitles   ProgramTemplateTargetJobTitle[]
  courses                          Course[]
  courseTemplates                  CourseTemplate[]
  courseTemplateTargetDepartments  CourseTemplateTargetDepartment[]
  courseTemplateTargetWorkUnits    CourseTemplateTargetWorkUnit[]
  courseTemplateTargetJobTitles    CourseTemplateTargetJobTitle[]
  attemptScoringPolicies           AttemptScoringPolicy[]
  questionBankQuestions            QuestionBankQuestion[]
  quizTemplates                    QuizTemplate[]
  quizzes                          Quiz[]
  assignments                      Assignment[]
  surveys                          Survey[]
  issuedCertificates               IssuedCertificate[]
  externalCertificates             ExternalCertificate[]
  learningLevels                   LearningLevel[]
  xpRules                          XpRule[]
  xpEvents                         XpEvent[]
  leaderboardRules                 LeaderboardRule[]
  tnaRequests                      TnaRequest[]
  approvalRequests                 ApprovalRequest[]
  notifications                    Notification[]
  notificationTemplates            NotificationTemplate[]
  savedReports                     SavedReport[]
  reportSchedules                  ReportSchedule[]
  reportExports                    ReportExport[]
  dashboardWidgets                 DashboardWidget[]
  certificateTemplateAssignments   CertificateTemplateAssignment[]
  certificateTemplateBorders       CertificateTemplateBorder[]
  scormPackages                    ScormPackage[]
  xapiStatements                   XapiStatement[]
  auditLogs                        AuditLog[]
  ModerationFlag                   ModerationFlag[]

  @@map("organizations")
}

model Department {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  parentDepartmentId String?  @map("parent_department_id") @db.Uuid
  name               String
  code               String?
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization           Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentDepartment       Department?                       @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments       Department[]                      @relation("DepartmentHierarchy")
  workUnits              WorkUnit[]
  users                  User[]
  courseTargets          CourseTargetDepartment[]
  programTargets         ProgramTargetDepartment[]
  courseTemplateTargets  CourseTemplateTargetDepartment[]
  programTemplateTargets ProgramTemplateTargetDepartment[]
  tnaRequests            TnaRequest[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@map("departments")
}

model WorkUnit {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  departmentId   String?  @map("department_id") @db.Uuid
  name           String
  code           String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization           Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department             Department?                     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  users                  User[]
  courseTargets          CourseTargetWorkUnit[]
  programTargets         ProgramTargetWorkUnit[]
  courseTemplateTargets  CourseTemplateTargetWorkUnit[]
  programTemplateTargets ProgramTemplateTargetWorkUnit[]
  tnaRequests            TnaRequest[]

  @@unique([organizationId, name])
  @@map("work_units")
}

model JobTitle {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  title          String
  jobFamily      String?  @map("job_family")
  grade          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization           Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users                  User[]
  courseTargets          CourseTargetJobTitle[]
  programTargets         ProgramTargetJobTitle[]
  courseTemplateTargets  CourseTemplateTargetJobTitle[]
  programTemplateTargets ProgramTemplateTargetJobTitle[]
  tnaRequests            TnaRequest[]

  @@unique([organizationId, title])
  @@map("job_titles")
}

model CompetencyGapArea {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tnaRequests  TnaRequest[]

  @@unique([organizationId, name])
  @@map("competency_gap_areas")
}

model User {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  employeeNumber String?     @map("employee_number")
  email          String      @db.Citext
  fullName       String      @map("full_name")
  preferredName  String?     @map("preferred_name")
  avatarUrl      String?     @map("avatar_url")
  departmentId   String?     @map("department_id") @db.Uuid
  workUnitId     String?     @map("work_unit_id") @db.Uuid
  jobTitleId     String?     @map("job_title_id") @db.Uuid
  managerUserId  String?     @map("manager_user_id") @db.Uuid
  status         ActorStatus @default(ACTIVE)
  hiredOn        DateTime?   @map("hired_on") @db.Date
  lastLoginAt    DateTime?   @map("last_login_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization                      Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department                        Department?                       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  workUnit                          WorkUnit?                         @relation(fields: [workUnitId], references: [id], onDelete: SetNull)
  jobTitle                          JobTitle?                         @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  manager                           User?                             @relation("UserManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  directReports                     User[]                            @relation("UserManager")
  roles                             UserRole[]
  assignedRoles                     UserRole[]                        @relation("RoleAssignedBy")
  uploadedFiles                     FileAsset[]                       @relation("UploadedFiles")
  createdCourses                    Course[]                          @relation("CourseCreator")
  ownedCourses                      Course[]                          @relation("CourseOwner")
  ownedPrograms                     Program[]                         @relation("ProgramOwner")
  createdPrograms                   Program[]                         @relation("ProgramCreatedBy")
  createdProgramCohorts             ProgramCohort[]                   @relation("ProgramCohortCreatedBy")
  programCohortMemberships          ProgramCohortMember[]
  programCohortMembersAdded         ProgramCohortMember[]             @relation("ProgramCohortMemberAddedBy")
  createdProgramTypes               ProgramType[]                     @relation("ProgramTypeCreatedBy")
  createdProgramTasks               ProgramTask[]                     @relation("ProgramTaskCreatedBy")
  createdProgramTemplates           ProgramTemplate[]                 @relation("ProgramTemplateCreatedBy")
  createdProgramTemplateTasks       ProgramTemplateTask[]             @relation("ProgramTemplateTaskCreatedBy")
  createdProgramTemplateCohorts     ProgramTemplateCohortDefault[]    @relation("ProgramTemplateCohortCreatedBy")
  courseEnrollments                 CourseEnrollment[]
  courseEnrollmentsCreated          CourseEnrollment[]                @relation("CourseEnrolledBy")
  programEnrollments                ProgramEnrollment[]
  programEnrollmentsCreated         ProgramEnrollment[]               @relation("ProgramEnrolledBy")
  quizAttempts                      QuizAttempt[]
  createdQuizzes                    Quiz[]                            @relation("QuizCreatedBy")
  createdQuizTemplates              QuizTemplate[]                    @relation("QuizTemplateCreatedBy")
  createdQuestions                  QuestionBankQuestion[]            @relation("QuestionCreatedBy")
  createdQuestionTypes              QuestionType[]                    @relation("QuestionTypeCreatedBy")
  reviews                           CourseReview[]
  reviewComments                    CourseReviewComment[]
  assignmentSubmissions             AssignmentSubmission[]
  createdAssignments                Assignment[]                      @relation("AssignmentCreatedBy")
  assignmentSubmissionsReviewed     AssignmentSubmission[]            @relation("AssignmentReviewer")
  peerReviews                       AssignmentPeerReview[]
  assignmentReviewsAssigned         AssignmentPeerReview[]            @relation("AssignmentPeerReviewer")
  surveyResponses                   SurveyResponse[]
  createdSurveys                    Survey[]                          @relation("SurveyCreatedBy")
  issuedCertificates                IssuedCertificate[]
  certificatesIssued                IssuedCertificate[]               @relation("CertificateIssuedBy")
  externalCertificates              ExternalCertificate[]
  xpEvents                          XpEvent[]
  createdXpEvents                   XpEvent[]                         @relation("XpEventCreatedBy")
  createdXpRules                    XpRule[]                          @relation("XpRuleCreatedBy")
  xpSummary                         UserXpSummary?
  tnaRequestsMade                   TnaRequest[]                      @relation("TnaRequester")
  tnaRequestsFor                    TnaRequest[]                      @relation("TnaLearner")
  fulfilledTnaRequests              TnaRequest[]                      @relation("TnaFulfilledBy")
  notifications                     Notification[]
  notificationTemplatesCreated      NotificationTemplate[]            @relation("NotificationTemplateCreatedBy")
  notificationSettings              NotificationSetting[]
  defaultOwnedProgramTemplates      ProgramTemplate[]                 @relation("ProgramTemplateDefaultOwner")
  createdCourseCategories           CourseCategory[]                  @relation("CourseCategoryCreatedBy")
  createdCourseVersions             CourseVersion[]                   @relation("CourseVersionCreatedBy")
  createdContentItems               CourseContentItem[]               @relation("ContentItemCreatedBy")
  createdContentAttachments         ContentItemAttachment[]           @relation("ContentAttachmentCreatedBy")
  createdCourseTemplates            CourseTemplate[]                  @relation("CourseTemplateCreatedBy")
  defaultOwnedCourseTemplates       CourseTemplate[]                  @relation("CourseTemplateDefaultOwner")
  defaultCreatedCourseTemplates     CourseTemplate[]                  @relation("CourseTemplateDefaultCreator")
  createdCourseTemplateContentItems CourseTemplateContentItem[]       @relation("CourseTemplateContentItemCreatedBy")
  createdCourseTemplateAttachments  CourseTemplateContentAttachment[] @relation("CourseTemplateAttachmentCreatedBy")
  createdAttemptScoringPolicies     AttemptScoringPolicy[]            @relation("AttemptPolicyCreatedBy")
  createdApprovalWorkflows          ApprovalWorkflow[]                @relation("ApprovalWorkflowCreatedBy")
  assignedApprovalSteps             ApprovalWorkflowStep[]            @relation("ApprovalStepUser")
  approvalRequests                  ApprovalRequest[]                 @relation("ApprovalRequestedBy")
  approvalActions                   ApprovalAction[]                  @relation("ApprovalActor")
  certificateTemplatesCreated       CertificateTemplate[]             @relation("CertificateTemplateCreatedBy")
  certificateSignerProfiles         CertificateTemplateSigner[]       @relation("CertificateSignerUser")
  ownedSavedReports                 SavedReport[]                     @relation("SavedReportOwner")
  reportExportsCreated              ReportExport[]                    @relation("ReportExportCreatedBy")
  scormAttempts                     ScormAttempt[]
  xapiStatements                    XapiStatement[]
  moderationFlagsReported           ModerationFlag[]                  @relation("ModerationReportedBy")
  moderationFlagsResolved           ModerationFlag[]                  @relation("ModerationResolvedBy")
  auditLogs                         AuditLog[]
  LeaderboardEntry                  LeaderboardEntry[]

  @@unique([organizationId, email])
  @@unique([organizationId, employeeNumber])
  @@index([organizationId])
  @@index([managerUserId])
  @@map("users")
}

model Role {
  id           String  @id @default(uuid()) @db.Uuid
  code         String  @unique
  name         String
  description  String?
  isSystemRole Boolean @default(true) @map("is_system_role")

  users                 UserRole[]
  approvalWorkflowSteps ApprovalWorkflowStep[]

  @@map("roles")
}

model UserRole {
  userId           String   @map("user_id") @db.Uuid
  roleId           String   @map("role_id") @db.Uuid
  assignedByUserId String?  @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime @default(now()) @map("assigned_at")

  user           User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedByUser User? @relation("RoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@map("user_roles")
}

model FileAsset {
  id               String     @id @default(uuid()) @db.Uuid
  organizationId   String     @map("organization_id") @db.Uuid
  uploadedByUserId String?    @map("uploaded_by_user_id") @db.Uuid
  fileName         String     @map("file_name")
  mimeType         String?    @map("mime_type")
  fileSizeBytes    BigInt?    @map("file_size_bytes")
  storageProvider  String     @default("local") @map("storage_provider")
  storageKey       String?    @map("storage_key")
  externalUrl      String?    @map("external_url")
  sourceKind       SourceKind @default(DEVICE_UPLOAD) @map("source_kind")
  providerFileId   String?    @map("provider_file_id")
  providerUrl      String?    @map("provider_url")
  metadataJson     Json       @default("{}") @map("metadata_json")
  checksumSha256   String?    @map("checksum_sha256")
  createdAt        DateTime   @default(now()) @map("created_at")

  organization                Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedByUser              User?                             @relation("UploadedFiles", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  certificateBackgrounds      CertificateTemplate[]             @relation("CertificateBackground")
  certificateTemplatePreviews CertificateTemplate[]             @relation("CertificateTemplatePreview")
  certificateSignatureAssets  CertificateTemplateSigner[]       @relation("CertificateSignatureAsset")
  certificateLayerAssets      CertificateTemplateLayer[]        @relation("CertificateLayerAsset")
  certificateTemplateAssets   CertificateTemplateAsset[]        @relation("CertificateTemplateAssetFile")
  courseThumbnails            Course[]                          @relation("CourseThumbnail")
  courseTemplateThumbnails    CourseTemplate[]                  @relation("CourseTemplateThumbnail")
  contentAttachments          ContentItemAttachment[]           @relation("ContentAttachmentFile")
  courseTemplateAttachments   CourseTemplateContentAttachment[] @relation("CourseTemplateAttachmentFile")
  scormPackages               ScormPackage[]                    @relation("ScormPackageFile")
  reportRunOutputs            ReportRun[]                       @relation("ReportOutputAsset")
  reportExports               ReportExport[]                    @relation("ReportExportAsset")
  assignmentSubmissionFiles   AssignmentSubmissionFile[]        @relation("AssignmentSubmissionFileAsset")
  issuedCertificatePdfs       IssuedCertificate[]               @relation("CertificatePdfAsset")
  externalCertificateSources  ExternalCertificate[]             @relation("ExternalCertificateSource")
  learningLevelBadges         LearningLevel[]                   @relation("LearningLevelBadge")

  @@map("file_assets")
}

model CourseCategory {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  name            String
  slug            String
  description     String?
  displayOrder    Int          @default(0) @map("display_order")
  isVisible       Boolean      @default(true) @map("is_visible")
  status          RecordStatus @default(ACTIVE)
  createdByUserId String?      @map("created_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?            @relation("CourseCategoryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  courses      Course[]
  templates    CourseTemplate[]

  @@unique([organizationId, slug])
  @@map("course_categories")
}

model CourseLevel {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  description    String?
  displayOrder   Int          @default(0) @map("display_order")
  isVisible      Boolean      @default(true) @map("is_visible")
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courses      Course[]
  templates    CourseTemplate[]

  @@unique([organizationId, name])
  @@map("course_levels")
}

model ContentType {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  code               String
  name               String
  description        String?
  allowedFormats     String?  @map("allowed_formats")
  maxFileSizeMb      Int?     @map("max_file_size_mb")
  requiresLrs        Boolean  @default(false) @map("requires_lrs")
  allowCreator       Boolean  @default(true) @map("allow_creator")
  allowLearnerUpload Boolean  @default(false) @map("allow_learner_upload")
  isEnabled          Boolean  @default(true) @map("is_enabled")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization         Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contentItems         CourseContentItem[]
  templateContentItems CourseTemplateContentItem[]

  @@unique([organizationId, code])
  @@map("content_types")
}

model QuestionType {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  code                String
  name                String
  description         String?
  configurationSchema Json     @default("{}") @map("configuration_schema")
  isEnabled           Boolean  @default(true) @map("is_enabled")
  createdByUserId     String?  @map("created_by_user_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
