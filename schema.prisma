

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

------------------------------------------------------------------------

enum ActorStatus {
  ACTIVE    @map("active")
  INVITED   @map("invited")
  SUSPENDED @map("suspended")
  ARCHIVED  @map("archived")

  @@map("actor_status")
}

enum RecordStatus {   //
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
  ARCHIVED @map("archived")
  RETIRED  @map("retired")

  @@map("record_status")
}

enum PublishStatus {
  DRAFT     @map("draft")
  IN_REVIEW @map("in_review")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")
  RETIRED   @map("retired")

  @@map("publish_status")
}

enum VisibilityScope {
  PUBLIC     @map("public")
  PRIVATE    @map("private")
  RESTRICTED @map("restricted")

  @@map("visibility_scope")
}

enum SourceKind {
  DEVICE_UPLOAD @map("device_upload")
  GOOGLE_DRIVE  @map("google_drive")
  EXTERNAL_URL  @map("external_url")
  BUILT_IN      @map("built_in")

  @@map("source_kind")
}

enum EnrollmentStatus {
  ASSIGNED    @map("assigned")
  ENROLLED    @map("enrolled")
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")
  FAILED      @map("failed")
  CANCELLED   @map("cancelled")
  EXPIRED     @map("expired")

  @@map("enrollment_status")
}

enum AssessmentPolicy {
  DISABLED  @map("disabled")
  OPTIONAL  @map("optional")
  MANDATORY @map("mandatory")

  @@map("assessment_policy")
}

enum QuizKind {
  PRE_COURSE    @map("pre_course")
  CHAPTER       @map("chapter")
  END_OF_COURSE @map("end_of_course")
  POST_COURSE   @map("post_course")
  STANDALONE    @map("standalone")

  @@map("quiz_kind")
}

enum AttemptStatus {
  STARTED   @map("started")
  SUBMITTED @map("submitted")
  PASSED    @map("passed")
  FAILED    @map("failed")
  ABANDONED @map("abandoned")

  @@map("attempt_status")
}

enum AssignmentSubmissionType {
  FILE @map("file")
  TEXT @map("text")
  LINK @map("link")

  @@map("assignment_submission_type")
}

enum AssignmentSubmissionStatus {
  NOT_SUBMITTED @map("not_submitted")
  SUBMITTED     @map("submitted")
  LATE          @map("late")
  RETURNED      @map("returned")
  GRADED        @map("graded")

  @@map("assignment_submission_status")
}

enum SurveyStatus {
  DRAFT    @map("draft")
  ACTIVE   @map("active")
  CLOSED   @map("closed")
  ARCHIVED @map("archived")

  @@map("survey_status")
}

enum CertificateStatus {
  DRAFT   @map("draft")
  ISSUED  @map("issued")
  REVOKED @map("revoked")
  EXPIRED @map("expired")
  RENEWED @map("renewed")

  @@map("certificate_status")
}

enum ApprovalStatus {
  PENDING   @map("pending")
  APPROVED  @map("approved")
  REJECTED  @map("rejected")
  CANCELLED @map("cancelled")

  @@map("approval_status")
}

enum ApprovalActionType {
  SUBMITTED @map("submitted")
  APPROVED  @map("approved")
  REJECTED  @map("rejected")
  RETURNED  @map("returned")
  CANCELLED @map("cancelled")

  @@map("approval_action_type")
}

enum TnaStatus {
  DRAFT     @map("draft")
  SUBMITTED @map("submitted")
  APPROVED  @map("approved")
  REJECTED  @map("rejected")
  FULFILLED @map("fulfilled")
  CANCELLED @map("cancelled")

  @@map("tna_status")
}

enum ModerationStatus {
  OPEN      @map("open")
  REVIEWING @map("reviewing")
  RESOLVED  @map("resolved")
  DISMISSED @map("dismissed")

  @@map("moderation_status")
}

enum XpEventType {
  COURSE_COMPLETION @map("course_completion")
  QUIZ_COMPLETION   @map("quiz_completion")
  QUIZ_PASS         @map("quiz_pass")
  PERFECT_SCORE     @map("perfect_score")
  PROGRAM_COMPLETION @map("program_completion")
  MANUAL_ADJUSTMENT @map("manual_adjustment")

  @@map("xp_event_type")
}

enum LeaderboardBasis {
  XP_POINTS           @map("xp_points")
  COURSE_COMPLETION   @map("course_completion")
  PROGRAM_PERFORMANCE @map("program_performance")

  @@map("leaderboard_basis")
}

enum ResetFrequency {
  WEEKLY    @map("weekly")
  MONTHLY   @map("monthly")
  QUARTERLY @map("quarterly")
  NEVER     @map("never")

  @@map("reset_frequency")
}

enum ReportRunStatus {
  QUEUED    @map("queued")
  RUNNING   @map("running")
  COMPLETED @map("completed")
  FAILED    @map("failed")

  @@map("report_run_status")
}

model Organization {
  id            String       @id @default(uuid()) @db.Uuid
  name          String       @unique
  legalName     String?      @map("legal_name")
  primaryDomain String?      @map("primary_domain") @db.Citext
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  departments              Department[]
  workUnits                WorkUnit[]
  jobTitles                JobTitle[]
  competencyGapAreas       CompetencyGapArea[]
  users                    User[]
  fileAssets               FileAsset[]
  courseCategories         CourseCategory[]
  courseLevels             CourseLevel[]
  contentTypes             ContentType[]
  questionTypes            QuestionType[]
  externalProviders        ExternalProvider[]
  approvalWorkflows        ApprovalWorkflow[]
  certificateTemplates     CertificateTemplate[]
  programTypes             ProgramType[]
  programs                 Program[]
  programTemplates         ProgramTemplate[]
  courses                  Course[]
  courseTemplates          CourseTemplate[]
  attemptScoringPolicies   AttemptScoringPolicy[]
  questionBankQuestions    QuestionBankQuestion[]
  quizTemplates            QuizTemplate[]
  quizzes                  Quiz[]
  assignments              Assignment[]
  surveys                  Survey[]
  issuedCertificates       IssuedCertificate[]
  externalCertificates     ExternalCertificate[]
  learningLevels           LearningLevel[]
  xpRules                  XpRule[]
  xpEvents                 XpEvent[]
  leaderboardRules         LeaderboardRule[]
  tnaRequests              TnaRequest[]
  approvalRequests         ApprovalRequest[]
  notifications            Notification[]
  savedReports             SavedReport[]
  dashboardWidgets         DashboardWidget[]
  auditLogs                AuditLog[]

  @@map("organizations")
}

model Department {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  parentDepartmentId String?      @map("parent_department_id") @db.Uuid
  name               String
  code               String?
  isActive           Boolean      @default(true) @map("is_active")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentDepartment    Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments    Department[] @relation("DepartmentHierarchy")
  workUnits           WorkUnit[]
  users               User[]
  courseTargets       CourseTargetDepartment[]
  programTargets      ProgramTargetDepartment[]
  tnaRequests         TnaRequest[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@map("departments")
}

model WorkUnit {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  departmentId   String?  @map("department_id") @db.Uuid
  name           String
  code           String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  users          User[]
  courseTargets  CourseTargetWorkUnit[]
  programTargets ProgramTargetWorkUnit[]
  tnaRequests    TnaRequest[]

  @@unique([organizationId, name])
  @@map("work_units")
}

model JobTitle {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  title          String
  jobFamily      String?  @map("job_family")
  grade          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  courseTargets  CourseTargetJobTitle[]
  programTargets ProgramTargetJobTitle[]
  tnaRequests    TnaRequest[]

  @@unique([organizationId, title])
  @@map("job_titles")
}

model CompetencyGapArea {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tnaRequests  TnaRequest[]

  @@unique([organizationId, name])
  @@map("competency_gap_areas")
}

model User {
  id               String      @id @default(uuid()) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  employeeNumber   String?     @map("employee_number")
  email            String      @db.Citext
  fullName         String      @map("full_name")
  preferredName    String?     @map("preferred_name")
  avatarUrl        String?     @map("avatar_url")
  departmentId     String?     @map("department_id") @db.Uuid
  workUnitId       String?     @map("work_unit_id") @db.Uuid
  jobTitleId       String?     @map("job_title_id") @db.Uuid
  managerUserId    String?     @map("manager_user_id") @db.Uuid
  status           ActorStatus @default(ACTIVE)
  hiredOn          DateTime?   @map("hired_on") @db.Date
  lastLoginAt      DateTime?   @map("last_login_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department          Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  workUnit            WorkUnit?    @relation(fields: [workUnitId], references: [id], onDelete: SetNull)
  jobTitle            JobTitle?    @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  manager             User?        @relation("UserManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  directReports       User[]       @relation("UserManager")
  roles               UserRole[]
  uploadedFiles       FileAsset[]  @relation("UploadedFiles")
  createdCourses      Course[]     @relation("CourseCreator")
  ownedCourses        Course[]     @relation("CourseOwner")
  courseEnrollments   CourseEnrollment[]
  programEnrollments  ProgramEnrollment[]
  quizAttempts        QuizAttempt[]
  reviews             CourseReview[]
  reviewComments      CourseReviewComment[]
  assignmentSubmissions AssignmentSubmission[]
  peerReviews         AssignmentPeerReview[]
  surveyResponses     SurveyResponse[]
  issuedCertificates  IssuedCertificate[]
  externalCertificates ExternalCertificate[]
  xpEvents            XpEvent[]
  xpSummary           UserXpSummary?
  tnaRequestsMade     TnaRequest[] @relation("TnaRequester")
  tnaRequestsFor      TnaRequest[] @relation("TnaLearner")
  notifications       Notification[]
  notificationSettings NotificationSetting[]
  auditLogs           AuditLog[]

  @@unique([organizationId, email])
  @@unique([organizationId, employeeNumber])
  @@index([organizationId])
  @@index([managerUserId])
  @@map("users")
}

model Role {
  id           String  @id @default(uuid()) @db.Uuid
  code         String  @unique
  name         String
  description  String?
  isSystemRole Boolean @default(true) @map("is_system_role")

  users                 UserRole[]
  approvalWorkflowSteps ApprovalWorkflowStep[]

  @@map("roles")
}

model UserRole {
  userId           String   @map("user_id") @db.Uuid
  roleId           String   @map("role_id") @db.Uuid
  assignedByUserId String?  @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime @default(now()) @map("assigned_at")

  user           User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedByUser User? @relation("RoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@map("user_roles")
}

model FileAsset {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  uploadedByUserId String? @map("uploaded_by_user_id") @db.Uuid
  fileName        String   @map("file_name")
  mimeType        String?  @map("mime_type")
  fileSizeBytes   BigInt?  @map("file_size_bytes")
  storageProvider String   @default("local") @map("storage_provider")
  storageKey      String?  @map("storage_key")
  externalUrl     String?  @map("external_url")
  checksumSha256  String?  @map("checksum_sha256")
  createdAt       DateTime @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedByUser User?        @relation("UploadedFiles", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@map("file_assets")
}

model CourseCategory {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  name            String
  slug            String
  description     String?
  displayOrder    Int          @default(0) @map("display_order")
  isVisible       Boolean      @default(true) @map("is_visible")
  status          RecordStatus @default(ACTIVE)
  createdByUserId String?      @map("created_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("CourseCategoryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  courses      Course[]
  templates    CourseTemplate[]

  @@unique([organizationId, slug])
  @@map("course_categories")
}

model CourseLevel {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  description    String?
  displayOrder   Int          @default(0) @map("display_order")
  isVisible      Boolean      @default(true) @map("is_visible")
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courses      Course[]
  templates    CourseTemplate[]

  @@unique([organizationId, name])
  @@map("course_levels")
}

model ContentType {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  code               String
  name               String
  description        String?
  allowedFormats     String?  @map("allowed_formats")
  maxFileSizeMb      Int?     @map("max_file_size_mb")
  requiresLrs        Boolean  @default(false) @map("requires_lrs")
  allowCreator       Boolean  @default(true) @map("allow_creator")
  allowLearnerUpload Boolean  @default(false) @map("allow_learner_upload")
  isEnabled          Boolean  @default(true) @map("is_enabled")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contentItems         CourseContentItem[]
  templateContentItems CourseTemplateContentItem[]

  @@unique([organizationId, code])
  @@map("content_types")
}

model QuestionType {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  code                String
  name                String
  description         String?
  configurationSchema Json     @default("{}") @map("configuration_schema")
  isEnabled           Boolean  @default(true) @map("is_enabled")
  createdByUserId     String?  @map("created_by_user_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("QuestionTypeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  questions    QuestionBankQuestion[]

  @@unique([organizationId, code])
  @@map("question_types")
}

model ExternalProvider {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  name              String
  providerType      String       @map("provider_type")
  integrationStatus RecordStatus @default(INACTIVE) @map("integration_status")
  integrationConfig Json         @default("{}") @map("integration_config")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tracks               ExternalProviderTrack[]
  externalCertificates ExternalCertificate[]

  @@unique([organizationId, name])
  @@map("external_providers")
}

model ExternalProviderTrack {
  id             String   @id @default(uuid()) @db.Uuid
  providerId     String   @map("provider_id") @db.Uuid
  name           String
  credentialName String?  @map("credential_name")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  provider ExternalProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, name])
  @@map("external_provider_tracks")
}

model ApprovalWorkflow {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  name            String
  appliesTo       String   @map("applies_to")
  description     String?
  isEnabled       Boolean  @default(true) @map("is_enabled")
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy          User?        @relation("ApprovalWorkflowCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  steps              ApprovalWorkflowStep[]
  programTypeEnrollments ProgramType[] @relation("ProgramTypeEnrollmentWorkflow")
  programTypeCompletions ProgramType[] @relation("ProgramTypeCompletionWorkflow")
  approvalRequests   ApprovalRequest[]

  @@unique([organizationId, name])
  @@map("approval_workflows")
}

model ApprovalWorkflowStep {
  id             String  @id @default(uuid()) @db.Uuid
  workflowId     String  @map("workflow_id") @db.Uuid
  stepOrder      Int     @map("step_order")
  stepName       String  @map("step_name")
  approverType   String  @map("approver_type")
  approverRoleId String? @map("approver_role_id") @db.Uuid
  approverUserId String? @map("approver_user_id") @db.Uuid
  isRequired     Boolean @default(true) @map("is_required")
  createdAt      DateTime @default(now()) @map("created_at")

  workflow     ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  approverRole Role?            @relation(fields: [approverRoleId], references: [id], onDelete: SetNull)
  approverUser User?            @relation("ApprovalStepUser", fields: [approverUserId], references: [id], onDelete: SetNull)
  approvalActions ApprovalAction[]

  @@unique([workflowId, stepOrder])
  @@map("approval_workflow_steps")
}

model CertificateTemplate {
  id                   String        @id @default(uuid()) @db.Uuid
  organizationId       String        @map("organization_id") @db.Uuid
  name                 String
  description          String?
  orientation          String        @default("landscape")
  backgroundAssetId    String?       @map("background_asset_id") @db.Uuid
  borderStyle          String?       @map("border_style")
  layoutJson           Json          @default("{}") @map("layout_json")
  includeOfficialStamp Boolean       @default(true) @map("include_official_stamp")
  lockWhenInUse        Boolean       @default(true) @map("lock_when_in_use")
  status               PublishStatus @default(DRAFT)
  createdByUserId      String?       @map("created_by_user_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  backgroundAsset  FileAsset?   @relation("CertificateBackground", fields: [backgroundAssetId], references: [id], onDelete: SetNull)
  createdBy        User?        @relation("CertificateTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  signers          CertificateTemplateSigner[]
  programTypes     ProgramType[]
  issuedCertificates IssuedCertificate[]

  @@unique([organizationId, name])
  @@map("certificate_templates")
}

model CertificateTemplateSigner {
  id               String   @id @default(uuid()) @db.Uuid
  templateId        String   @map("template_id") @db.Uuid
  signerUserId      String?  @map("signer_user_id") @db.Uuid
  signerName        String   @map("signer_name")
  signerTitle       String   @map("signer_title")
  signatureAssetId  String?  @map("signature_asset_id") @db.Uuid
  displayOrder      Int      @default(1) @map("display_order")
  isRequired        Boolean  @default(true) @map("is_required")
  createdAt         DateTime @default(now()) @map("created_at")

  template       CertificateTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  signerUser     User?               @relation("CertificateSignerUser", fields: [signerUserId], references: [id], onDelete: SetNull)
  signatureAsset FileAsset?          @relation("CertificateSignatureAsset", fields: [signatureAssetId], references: [id], onDelete: SetNull)

  @@unique([templateId, displayOrder])
  @@map("certificate_template_signers")
}

model ProgramType {
  id                           String       @id @default(uuid()) @db.Uuid
  organizationId               String       @map("organization_id") @db.Uuid
  name                         String
  description                  String?
  defaultDurationDays          Int?         @map("default_duration_days")
  defaultCertificateTemplateId String?      @map("default_certificate_template_id") @db.Uuid
  defaultXpMultiplier          Decimal      @default(1.00) @map("default_xp_multiplier") @db.Decimal(6, 2)
  enrollmentWorkflowId         String?      @map("enrollment_workflow_id") @db.Uuid
  completionWorkflowId         String?      @map("completion_workflow_id") @db.Uuid
  status                       RecordStatus @default(ACTIVE)
  createdByUserId              String?      @map("created_by_user_id") @db.Uuid
  createdAt                    DateTime     @default(now()) @map("created_at")
  updatedAt                    DateTime     @updatedAt @map("updated_at")

  organization               Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultCertificateTemplate CertificateTemplate? @relation(fields: [defaultCertificateTemplateId], references: [id], onDelete: SetNull)
  enrollmentWorkflow         ApprovalWorkflow?    @relation("ProgramTypeEnrollmentWorkflow", fields: [enrollmentWorkflowId], references: [id], onDelete: SetNull)
  completionWorkflow         ApprovalWorkflow?    @relation("ProgramTypeCompletionWorkflow", fields: [completionWorkflowId], references: [id], onDelete: SetNull)
  createdBy                  User?                @relation("ProgramTypeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  programs                   Program[]
  templates                  ProgramTemplate[]

  @@unique([organizationId, name])
  @@map("program_types")
}

model Program {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  programTypeId  String?         @map("program_type_id") @db.Uuid
  ownerUserId    String?         @map("owner_user_id") @db.Uuid
  name           String
  description    String?
  targetAudience String?         @map("target_audience")
  visibility     VisibilityScope @default(PRIVATE)
  status         PublishStatus   @default(DRAFT)
  startDate      DateTime?       @map("start_date") @db.Date
  endDate        DateTime?       @map("end_date") @db.Date
  xpMultiplier   Decimal         @default(1.00) @map("xp_multiplier") @db.Decimal(6, 2)
  createdByUserId String?        @map("created_by_user_id") @db.Uuid
  publishedAt    DateTime?       @map("published_at")
  archivedAt     DateTime?       @map("archived_at")
