  @@unique([snapshotId, rankNumber])
  @@map("leaderboard_entries")
}

model TnaRequest {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  requesterUserId       String    @map("requester_user_id") @db.Uuid
  learnerUserId         String?   @map("learner_user_id") @db.Uuid
  departmentId          String?   @map("department_id") @db.Uuid
  workUnitId            String?   @map("work_unit_id") @db.Uuid
  jobTitleId            String?   @map("job_title_id") @db.Uuid
  competencyGapAreaId   String?   @map("competency_gap_area_id") @db.Uuid
  requestType           String    @default("individual") @map("request_type")
  preferredTrainingFormat String? @map("preferred_training_format")
  preferredStartDate    DateTime? @map("preferred_start_date") @db.Date
  targetCompletionDate  DateTime? @map("target_completion_date") @db.Date
  businessJustification String?   @map("business_justification")
  status                TnaStatus @default(DRAFT)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester         User @relation("TnaRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  learner           User? @relation("TnaLearner", fields: [learnerUserId], references: [id], onDelete: SetNull)
  department        Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  workUnit          WorkUnit? @relation(fields: [workUnitId], references: [id], onDelete: SetNull)
  jobTitle          JobTitle? @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  competencyGapArea CompetencyGapArea? @relation(fields: [competencyGapAreaId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("tna_requests")
}

model ApprovalRequest {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  workflowId        String?        @map("workflow_id") @db.Uuid
  subjectType       String         @map("subject_type")
  subjectId         String         @map("subject_id") @db.Uuid
  requestedByUserId String?        @map("requested_by_user_id") @db.Uuid
  status            ApprovalStatus @default(PENDING)
  requestedAt       DateTime       @default(now()) @map("requested_at")
  completedAt       DateTime?      @map("completed_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow        ApprovalWorkflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  requestedByUser User? @relation("ApprovalRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  actions         ApprovalAction[]

  @@map("approval_requests")
}

model ApprovalAction {
  id                String             @id @default(uuid()) @db.Uuid
  approvalRequestId String             @map("approval_request_id") @db.Uuid
  workflowStepId    String?            @map("workflow_step_id") @db.Uuid
  actorUserId       String?            @map("actor_user_id") @db.Uuid
  action            ApprovalActionType
  comments          String?
  createdAt         DateTime           @default(now()) @map("created_at")

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  workflowStep    ApprovalWorkflowStep? @relation(fields: [workflowStepId], references: [id], onDelete: SetNull)
  actorUser       User? @relation("ApprovalActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@map("approval_actions")
}

model NotificationSetting {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  channel          String
  notificationType String   @map("notification_type")
  isEnabled        Boolean  @default(true) @map("is_enabled")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, notificationType])
  @@map("notification_settings")
}

model Notification {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  title            String
  body             String?
  notificationType String   @map("notification_type")
  actionUrl        String?  @map("action_url")
  readAt           DateTime? @map("read_at")
  createdAt        DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model SavedReport {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  ownerUserId    String?  @map("owner_user_id") @db.Uuid
  name           String
  reportType     String   @map("report_type")
  filtersJson    Json     @default("{}") @map("filters_json")
  scheduleCron   String?  @map("schedule_cron")
  isEnabled      Boolean  @default(true) @map("is_enabled")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("SavedReportOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  runs         ReportRun[]

  @@unique([organizationId, name])
  @@map("saved_reports")
}

model ReportRun {
  id            String          @id @default(uuid()) @db.Uuid
  reportId      String          @map("report_id") @db.Uuid
  status        ReportRunStatus @default(QUEUED)
  outputAssetId String?         @map("output_asset_id") @db.Uuid
  startedAt     DateTime?       @map("started_at")
  completedAt   DateTime?       @map("completed_at")
  errorMessage  String?         @map("error_message")

  report      SavedReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  outputAsset FileAsset?  @relation("ReportOutputAsset", fields: [outputAssetId], references: [id], onDelete: SetNull)

  @@map("report_runs")
}

model DashboardWidget {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  kpiKey         String   @map("kpi_key")
  section        String
  chartType      String   @map("chart_type")
  displayOrder   Int      @default(0) @map("display_order")
  isEnabled      Boolean  @default(true) @map("is_enabled")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@map("dashboard_widgets")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  action         String
  beforeJson     Json?    @map("before_json")
  afterJson      Json?    @map("after_json")
  ipAddress      String?  @map("ip_address") @db.Inet
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorUser    User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@map("audit_logs")
}
